{
  "version": 2,
  "buildCommand": "pnpm build:vercel",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "functions": {
    "api/upload.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/upload", "destination": "/api/upload.ts" },
    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}
